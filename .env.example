# =============================================================================
# RewardStar Docker Environment Configuration
# =============================================================================
# IMPORTANT: Copy this file to .env and configure all variables before running
# docker-compose up. The application will NOT start without a properly
# configured .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API Configuration
# -----------------------------------------------------------------------------

# Port for the backend API
# This is used in both the Dockerfile (EXPOSE, health checks) and docker-compose.yml
API_PORT=5002

# ASP.NET Core URLs configuration
# Format: http://+:{port} to listen on all interfaces
ASPNETCORE_URLS=http://+:5002

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# The application supports both SQLite and PostgreSQL.
# To use PostgreSQL, set DATABASE_URL. If DATABASE_URL is set, SQLite is ignored.
# If DATABASE_URL is not set, the application uses SQLite with DB_PATH.

# PostgreSQL Configuration (recommended for production)
# If using the PostgreSQL container from docker-compose, use these settings:
POSTGRES_DB=RewardStar
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_HOST_PORT=5432

# PostgreSQL connection string (optional - if set, PostgreSQL will be used)
# Format: Host=hostname;Port=5432;Database=dbname;Username=user;Password=pass
# IMPORTANT: In Docker, use "postgres" as hostname (the service name), NOT "localhost"
DATABASE_URL=Host=host;Port=5432;Database=RewardStar;Username=username;Password=Password

# Database path for SQLite (used when DATABASE_URL is not set or commented out)
# This path is inside the Docker container and will be mounted to a volume
# To use SQLite instead of PostgreSQL, comment out DATABASE_URL above
DB_PATH=/app/data/RewardStar.db

# ASP.NET Core environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Production

# Google OAuth Configuration (shared between frontend and backend)
# Get this from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Instructions:
#   1. Go to https://console.cloud.google.com/
#   2. Create a new project or select existing project
#   3. Enable "Google+ API"
#   4. Go to "Credentials" > "Create Credentials" > "OAuth 2.0 Client ID"
#   5. Configure OAuth consent screen
#   6. Create OAuth 2.0 Client ID:
#      - Application type: Web application
#      - Authorized JavaScript origins: http://localhost:3000
#      - Authorized redirect URIs: http://localhost:3000
#   7. Copy the Client ID and paste it below
# This variable is used by both frontend and backend
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# JWT Configuration
# Session expiration time in minutes
# Default: 60 minutes (1 hour)
JWT_EXPIRY_MINUTES=60

# -----------------------------------------------------------------------------
# Observability (OpenTelemetry) - Optional
# -----------------------------------------------------------------------------
# The API exports traces, metrics and logs over OTLP.
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty or commented out to DISABLE telemetry
# entirely - the API then behaves exactly as it did before instrumentation.
#
# To collect locally, start the Aspire Dashboard first:
#   ./scripts/otel-dashboard.ps1        (UI on http://localhost:18888)
#
# IMPORTANT: this file configures the CONTAINER, so the dashboard running on the
# host is "host.docker.internal", NOT "localhost". Outside Docker the endpoint is
# http://localhost:18889 and it is already set in launchSettings.json.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:18889

# OTLP transport: grpc (default) or http/protobuf
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------

# API URL for the frontend to connect to the backend
# In Docker: Use the backend service name and internal port
# Format: http://backend:{API_PORT}/api
# For local host access: http://localhost:{API_PORT}/api
VITE_API_URL=http://localhost:5002/api

# Application name (optional)
VITE_APP_NAME=RewardStar

# -----------------------------------------------------------------------------
# Docker Compose Configuration
# -----------------------------------------------------------------------------

# Host port mapping for backend API
# Maps container port (API_PORT) to host port
# Example: 5002:5002 means localhost:5002 on your machine -> container:5002
BACKEND_HOST_PORT=5002

# Host port mapping for frontend
# Maps container port 80 to host port
# Example: 3000 means localhost:3000 on your machine -> container:80
FRONTEND_HOST_PORT=3000

# -----------------------------------------------------------------------------
# Volume Configuration (Optional - uses defaults if not specified)
# -----------------------------------------------------------------------------

# Name for the backend data volume (for SQLite database)
# Default: rewardstar_backend-data
# BACKEND_VOLUME_NAME=rewardstar_backend-data
